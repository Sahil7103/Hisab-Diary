<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="62dp"
    android:orientation="vertical" android:paddingTop="4dp">
    <TextView android:id="@+id/widget_vendor_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#1B2233" android:textSize="13sp"
        android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_vendor_status" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#55607A" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@+id/widget_vendor_came" android:layout_width="wrap_content"
            android:layout_height="38dp" android:minWidth="60dp" android:minHeight="0dp"
            android:textAllCaps="false" android:textSize="11sp" android:textColor="#1E8A4C"
            android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@+id/widget_vendor_absent" android:layout_width="wrap_content"
            android:layout_height="38dp" android:minWidth="60dp" android:minHeight="0dp"
            android:textAllCaps="false" android:textSize="11sp" android:textColor="#D2382C"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
