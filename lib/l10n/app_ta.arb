  "tutorialTabsBody": "இன்று: தினசரி குறிகள். மாதம்: நாட்காட்டி. பில்: மொத்தம் மற்றும் WhatsApp பகிர்வு. அமைப்புகள்: மொழி, நினைவூட்டல்.",
  "tutorialNext": "அடுத்து",
  "tutorialDone": "டைரியைத் தொடங்கவும்",
  "tutorialSkip": "வழிகாட்டலைத் தவிர்க்கவும்",
  "tutorialVendorTitle": "கணக்கைத் தேர்ந்தெடுக்கவும்",
  "tutorialVendorBody": "வீட்டுக் கணக்குகளுக்கு இடையே மாற கணக்கைத் தேர்ந்தெடுக்கவும் என்பதைத் தட்டவும்.",
  "tutorialMonthTitle": "மாதத்தைத் தேர்ந்தெடுக்கவும்",
  "tutorialMonthBody": "மாதத்தை மாற்ற இடது, வலது அம்புகளைப் பயன்படுத்தவும்.",
  "tutorialCalendarTitle": "தினசரி குறியைத் திருத்தவும்",
  "tutorialCalendarBody": "குறியை மாற்ற கடந்த நாள் அல்லது இன்றைய நாளைத் தட்டவும். எதிர்கால நாட்களைக் குறிக்க முடியாது.",
  "tutorialTotalTitle": "இதுவரை மொத்தத்தைப் பார்க்கவும்",
  "tutorialTotalBody": "நாட்காட்டிக்குக் கீழே மொத்தம் விநியோக நாட்கள், தினசரி அளவு மற்றும் விலைக்கு ஏற்ப மாறும்.",
  "tutorialBillTotalTitle": "பில்லைச் சரிபார்க்கவும்",
  "tutorialBillTotalBody": "தேர்ந்த கணக்கு, மாதத்தின் விநியோக எண்ணிக்கை, மொத்தத்தைச் சரிபார்க்கவும். பில் இயல்பாக நடப்பு மாதத்தில் திறக்கும்.",
  "tutorialShareTitle": "WhatsApp-இல் பகிரவும்",
  "tutorialShareBody": "WhatsApp-இல் பகிரவும் என்பதைத் தட்டவும். அனுப்பும் முன் பில்லைச் சரிபார்த்து பெறுநரைத் தேர்ந்தெடுக்கவும்.",
  "tutorialPaidTitle": "பணம் செலுத்தியதைப் பதிவு செய்யவும்",
  "tutorialPaidBody": "பணம் செலுத்திய பின் செலுத்தியதாகக் குறிக்கவும் என்பதைத் தட்டவும். இது நிலையை மட்டுமே பதிவு செய்யும்; பணம் அனுப்பாது.",
  "billMessage": "வணக்கம் {name} 🙏\n{month} {vendorType} பில்: {days} நாட்கள் × {quantity} {unit} = {total}.\nநன்றி! — {appName}\nPlay Store: [இணைப்பு விரைவில்]",
  "restoreSummary": "{vendorCount} கணக்குகள், {entryCount} தினசரி குறிகளுடன் டைரியை மாற்றவா? தற்போதைய கணக்குகள், குறிகள், விலைகள், பணப்பதிவுகள், அமைப்புகள் மாற்றப்படும்.",
  "reminderBatteryIntro": "சில போன்கள் பின்னணி செயலிகளை நிறுத்தும். நினைவூட்டல் வராவிட்டால் டைரியை பின்னணியில் அனுமதிக்கவும். அமைப்புப் பெயர்கள் போனுக்கு ஏற்ப மாறும்.",
  "reminderXiaomi": "Xiaomi: Autostart அனுமதித்து, பேட்டரி அமைப்பில் No restrictions தேர்ந்தெடுக்கவும்.",
  "reminderOppo": "Oppo: செயலி அல்லது பேட்டரி அமைப்பில் தானியக்கத் தொடக்கம், பின்னணி இயக்கம் அனுமதிக்கவும்.",
  "reminderVivo": "Vivo: டைரிக்கு Autostart, பின்னணி மின் பயன்பாடு அனுமதிக்கவும்.",
  "reminderRealme": "Realme: செயலி பேட்டரி நிர்வாகத்தில் தானியக்கத் தொடக்கம், பின்னணி இயக்கம் அனுமதிக்கவும்.",
  "proUpgradeTitle": "அதிக கணக்குகள். ஒரு எளிய டைரி.",
  "proEverydayHeading": "இலவசம், Pro-வில் தினசரி வசதிகள்",
  "proDailyHook": "வீட்டு விநியோகங்களை ஒரே தட்டலில் குறிக்கவும்.",
  "proRecordsHook": "தெளிவான பதிவுகள் மாத இறுதி கருத்து வேறுபாடுகளைக் குறைக்கும்.",
  "proShareHook": "மாத பில்லை WhatsApp-இல் பகிரவும்.",
  "proOfflineHook": "இணையம், உள்நுழைவு இல்லாமல் கணக்குகளை வைத்திருங்கள்.",
  "vendorLimitReached": "உங்கள் திட்டத்தில் {limit} கணக்குகள் அனுமதிக்கப்படும். கணக்கைக் காப்பகத்தில் வைக்கவும் அல்லது அமைப்புகளில் Pro வாங்கவும்.",
  "archiveExplanation": "காப்பகத்தில் வைத்தால் கணக்கு இன்று பகுதியில் நீங்கும். குறிகள், விலைகள், செலுத்திய பில்கள் பாதுகாக்கப்படும். மீண்டும் செயல்படுத்தலாம்.",
  "privacyPolicy": "தனியுரிமைக் கொள்கை",
  "privacyPolicyOpenError": "தனியுரிமைக் கொள்கையைத் திறக்க முடியவில்லை. உலாவி மற்றும் இணைய இணைப்பைச் சரிபார்க்கவும்.",
  "accountTitle": "உங்கள் கணக்கு",
  "accountIntro": "உள்நுழைவு விருப்பத்திற்குரியது. நாட்குறிப்பு இந்தச் சாதனத்தில் இருக்கும். மேகக் காப்புப்பிரதி பின்னர் சேர்க்கப்படும்.",
  "signIn": "உள்நுழைக",
  "createAccount": "கணக்கை உருவாக்கு",
  "googleSignIn": "Google மூலம் தொடர்க",
  "emailLabel": "மின்னஞ்சல்",
  "passwordLabel": "கடவுச்சொல்",
  "confirmPasswordLabel": "கடவுச்சொல்லை உறுதிப்படுத்து",
  "forgotPassword": "கடவுச்சொல் மறந்துவிட்டதா?",
  "resetSent": "இந்த மின்னஞ்சலுக்குக் கணக்கு இருந்தால் கடவுச்சொல் மீட்டமைப்பு இணைப்பு அனுப்பப்படும். அஞ்சலைப் பார்க்கவும்.",
  "authEmailInvalid": "சரியான மின்னஞ்சல் முகவரியை உள்ளிடவும்.",
  "authPasswordRequired": "கடவுச்சொல்லை உள்ளிடவும்.",
  "authPasswordWeak": "குறைந்தது 6 எழுத்துகள் கொண்ட கடவுச்சொல்லைப் பயன்படுத்தவும்.",
  "authPasswordMismatch": "கடவுச்சொற்கள் பொருந்தவில்லை.",
  "authInvalidCredentials": "மின்னஞ்சல் அல்லது கடவுச்சொல் தவறு.",
  "authEmailUsed": "இந்த மின்னஞ்சலுக்குக் கணக்கு உள்ளது. உள்நுழையவும்.",
  "authNetworkError": "இணைய இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்.",
  "authUnavailable": "உள்நுழைவு கிடைக்கவில்லை. Firebase அமைப்பைச் சரிபார்க்கவும்.",
  "authTryAgain": "செயலை முடிக்க முடியவில்லை. பின்னர் முயலவும்.",
  "authRecentLogin": "கணக்கை நீக்கும் முன் வெளியேறி மீண்டும் உள்நுழையவும்.",
  "signOut": "வெளியேறு",
  "deleteAccount": "கணக்கை நீக்கு",
  "deleteAccountConfirm": "உள்நுழைவுக் கணக்கை நீக்கவா? இந்தச் சாதனத்தின் நாட்குறிப்பு பதிவுகள் இருக்கும்.",
  "signedInAs": "உள்நுழைந்த கணக்கு",
  "continueOffline": "ஆஃப்லைனில் தொடர்க",
  "showPassword": "கடவுச்சொல்லைக் காட்டு",
  "hidePassword": "கடவுச்சொல்லை மறை",
  "helpAssistant": "உதவி வழிகாட்டி",
  "helpIntro": "நாட்குறிப்பைப் பயன்படுத்துவது பற்றி கேளுங்கள் அல்லது கீழே ஒரு பணியைத் தேர்ந்தெடுங்கள். உரிய திரையில் வழிகாட்டுவோம்.",
  "helpQuestion": "என்ன செய்ய விரும்புகிறீர்கள்?",
  "helpShowMe": "காட்டுங்கள்",
  "helpNoMatch": "வழிகாட்ட கீழே ஒரு பணியைத் தேர்ந்தெடுங்கள்.",
  "helpChoices": "எந்தப் பணிக்கு உதவி வேண்டும்?",
  "helpReminderBody": "நினைவூட்டலை இயக்கி, அறிவிப்பு அனுமதி அளித்து, நேரத்தைத் தேர்ந்தெடுங்கள்.",
  "helpBackupBody": "காப்புப்பிரதி எடுக்க இங்கே தட்டுங்கள். கோப்பைப் பாதுகாப்பாக வைத்திருங்கள்.",
  "helpRestoreBody": "காப்புப்பிரதியைத் தேர்ந்தெடுக்க இங்கே தட்டுங்கள். உறுதிப்படுத்தலை கவனமாகப் படியுங்கள்: இந்த சாதனத்தின் நாட்குறிப்பு மாற்றப்படும்.",
  "assistantHello": "வணக்கம்! நான் உங்கள் நாட்குறிப்பு உதவியாளர்.",
  "assistantWelcome": "உதவி தேவைப்படும்போது மிதக்கும் பென்சிலைத் தட்டுங்கள். பணியைத் தேர்ந்தெடுங்கள் அல்லது கேள்வி கேளுங்கள்; எங்கே தட்ட வேண்டும் என்று காட்டுவேன். சிறிய அறிமுகத்துடன் தொடங்கலாம்!",
  "editVendor": "கணக்கைத் திருத்தவும்",
  "deleteVendor": "கணக்கை நீக்கவும்",
  "deleteVendorConfirm": "{name} கணக்கை நீக்கவா? அதன் தினசரி பதிவுகள், சேமித்த விலைகள் மற்றும் பணம் செலுத்திய வரலாறும் நீக்கப்படும். இதை மீட்டெடுக்க முடியாது.",
  "editVendorRatesInfo": "அளவு மற்றும் விலை மாற்றங்கள் இந்த மாதம் முதல் பொருந்தும். விநியோக நாட்களை மாற்றினால் பதிவு செய்யாத நாட்களின் கணக்கும் மாறும்."
}
